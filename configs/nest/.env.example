# Nest Data Application Configuration
# Copy this file to .env and fill in your values

# Google OAuth - path inside container where client_secret.json is mounted
CLIENT_SECRET_FILE=/secrets/client_secret.json

# OAuth callback URL - must match your Google Cloud Console redirect URI
REDIRECT_URI=http://nest.home/auth/callback

# Google Cloud Project ID (from Device Access Console)
PROJECT_ID=your-google-project-id

# PostgreSQL Database Configuration
DB_HOST=nest-postgres
DB_USER=nest
DB_NAME=nest_data
DB_PASSWORD=your-secure-password-here
DB_PORT=5432
